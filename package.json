{
  "name": "inplace-api",
  "version": "0.2.0",
  "description": "InPlace — On-demand care coordination API",
  "main": "src/server.js",
  "scripts": {
    "build": "node scripts/build-client.js",
    "start": "npm run build && node src/server.js",
    "dev": "node scripts/build-client.js && node --watch src/server.js",
    "seed": "node src/seed.js",
    "setup": "node src/seed.js && node src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "collect-feedback": "node scripts/collect-feedback.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-optional-chaining": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@sentry/node": "^10.64.0",
    "@simplewebauthn/server": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "otplib": "^13.3.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.9.2",
    "socket.io": "^4.8.3",
    "stripe": "^20.3.1",
    "twilio": "^5.12.2",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@scure/base": "1.2.6",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": []
  }
}
