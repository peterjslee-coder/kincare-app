# InPlace API Configuration
PORT=3001
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development

# PostgreSQL connection string
# For local dev: install PostgreSQL, create a database, then set this:
DATABASE_URL=postgresql://user:password@localhost:5432/inplace

# Email notifications (waitlist signups) — uses Resend HTTP API
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
NOTIFY_EMAIL=peterjslee@gmail.com

# Stripe Connect — payment processing
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Base URL for Stripe redirect URLs
BASE_URL=http://localhost:3001

# Push Notifications — VAPID keys for Web Push
# Auto-generated on first server start and saved to database if not set here.
# Generate manually: node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log('PUBLIC=' + k.publicKey); console.log('PRIVATE=' + k.privateKey)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Twilio — SMS reminders + in-app video/voice calls (optional)
# Get credentials at https://console.twilio.com
# If not set, SMS reminders and video/voice calls are silently skipped
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Video/Voice calls require an API Key (create at Console > API Keys)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Admin API key — used by scripts (e.g. collect-feedback) to bypass login/2FA
# Generate a random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
