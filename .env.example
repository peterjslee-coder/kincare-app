# InPlace API Configuration
PORT=3001
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development

# PostgreSQL connection string
# For local dev: install PostgreSQL, create a database, then set this:
DATABASE_URL=postgresql://user:password@localhost:5432/inplace

# Email notifications (waitlist signups) — uses Resend HTTP API
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
NOTIFY_EMAIL=peterjslee@gmail.com

# Stripe Connect — payment processing
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Base URL for Stripe redirect URLs
BASE_URL=http://localhost:3001
