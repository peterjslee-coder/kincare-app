<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>InPlace</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.yourinplace.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>inplace</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- v1.105.7 — location is a SAFETY feature: check-in/out proves the caregiver was at
	     the home. WHEN-IN-USE only, deliberately: there is no background location, no
	     NSLocationAlwaysAndWhenInUseUsageDescription, and no background mode. Declaring the
	     minimum is both honest and the easiest thing to defend in review.
	     Until this key existed, calling navigator.geolocation on iOS TERMINATED the app. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>InPlace records your location when you check in and out of a care visit, so the family knows their caregiver arrived at the home. Your location is never collected in the background or when you are not on a visit.</string>
	<key>NSCameraUsageDescription</key>
	<string>InPlace uses the camera to photograph receipts, care documents, and your ID for identity verification, and for video calls with your care team.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>InPlace lets you choose existing photos of receipts, documents, and profile pictures from your photo library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>InPlace uses the microphone for video calls with your care team.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
