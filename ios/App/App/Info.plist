<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>InPlace</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.yourinplace.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>inplace</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- v1.105.12 — export compliance. Without this key, App Store Connect stops EVERY
	     upload to ask the export-compliance question by hand, and an unanswered build
	     cannot be submitted or sent to TestFlight testers.

	     `false` is the accurate answer, not a convenience. It asserts the app uses no
	     NON-exempt encryption. Everything InPlace does falls inside a published exemption:
	       - HTTPS/TLS to the API — standard encryption provided by the OS.
	       - bcryptjs password hashing and TOTP/HMAC — hashing and authentication, which
	         are not "encryption" for export purposes at all.
	       - JWT signing — signing, not confidentiality.
	       - WebAuthn/passkeys — performed by the Secure Enclave and the platform.
	     If InPlace ever ships its OWN crypto (custom key exchange, proprietary cipher,
	     end-to-end encrypted messaging with app-managed keys), this must flip to true and
	     a CCATS/self-classification report becomes required. Revisit then, not before. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- v1.105.7 — location is a SAFETY feature: check-in/out proves the caregiver was at
	     the home. WHEN-IN-USE only: there is no background location and no background mode.
	     Until this key existed, calling navigator.geolocation on iOS TERMINATED the app.

	     v1.105.58 — the Always key is now present too, and that is NOT a change of
	     behaviour. Build 8 came back with ITMS-90683: @capacitor/geolocation's binary
	     references NSLocationAlwaysAndWhenInUseUsageDescription, so Apple's static analysis
	     demands the string whether or not we use it. Verified in the plugin source before
	     adding it: GeolocationPlugin.swift only ever READS .authorisedAlways as an
	     already-granted state (lines 95, 139, 239); there is no requestAlwaysAuthorization
	     call anywhere in it. The app still asks for when-in-use and nothing more, so this
	     prompt should never actually appear — but the string has to be honest in case it
	     ever does, and it must not claim a capability we don't use.

	     Declaring the minimum was the right instinct and still is; this is the minimum that
	     ships. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>InPlace records your location when you check in and out of a care visit, so the family knows their caregiver arrived at the home. Your location is never collected in the background or when you are not on a visit.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>InPlace only uses your location while you are using the app, to record check in and check out at a care visit so the family knows their caregiver arrived at the home. InPlace does not track your location in the background.</string>
	<key>NSCameraUsageDescription</key>
	<string>InPlace uses the camera to photograph receipts, care documents, and your ID for identity verification, and for video calls with your care team.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>InPlace lets you choose existing photos of receipts, documents, and profile pictures from your photo library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>InPlace uses the microphone for video calls with your care team.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
